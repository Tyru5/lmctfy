# --- Vercel Sandbox auth (pick one) ---
# a) `vercel login && vercel env pull`  -> writes VERCEL_OIDC_TOKEN to .env.local (12h)
# b) token from vercel.com/account/tokens (durable)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --- model keys. Brokered at the sandbox firewall; never enter the VM ---
# Without its direct provider key, each agent falls back to AI_GATEWAY_API_KEY
# or the OIDC token when AI_GATEWAY_USE_OIDC=1 (team needs gateway credits).
AI_GATEWAY_API_KEY=
AI_GATEWAY_USE_OIDC=        # 1 = use VERCEL_OIDC_TOKEN as the gateway credential
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- model (default gpt-5.1-codex-mini; openai/gpt-5.1-codex-mini on Gateway) ---
# Gateway overrides must include the provider prefix, e.g. openai/gpt-5.3-codex.
CODEX_MODEL=
CLAUDE_MODEL=          # default claude-haiku-4-5

# --- link signing (required for live runs; `openssl rand -hex 32`) ---
LINK_SECRET=

# --- cache + durable limits: injected by `vercel integration add upstash/upstash-kv` ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- limits ---
RUN_MAX_CONCURRENT=3
RUN_PER_IP=3            # runs per IP per window
RUN_WINDOW_MS=600000
RUN_DAILY_CAP=100
